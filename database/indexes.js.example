    ]
  }
];

// Security Rules for Firestore
const firestoreRules = `
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users can read and write their own user document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Health data is private to the user
    match /healthData/{documentId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
    }
    
    // Communities are readable by all authenticated users
    match /communities/{communityId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.createdBy;
      allow update: if request.auth != null && 
        (request.auth.uid == resource.data.createdBy || 
         request.auth.uid in resource.data.admins);
      
      // Community members subcollection
      match /members/{userId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    // Challenges are readable by all authenticated users
    match /challenges/{challengeId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.createdBy;
      allow update: if request.auth != null && request.auth.uid == resource.data.createdBy;
      
      // Challenge participants subcollection
      match /participants/{userId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    // Posts are readable by community members
    match /posts/{postId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.authorId;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.authorId;
    }
    
    // Achievements are readable by all authenticated users
    match /achievements/{achievementId} {
      allow read: if request.auth != null;
    }
    
    // User achievements are private to the user
    match /users/{userId}/achievements/{achievementId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Notifications are private to the user
    match /notifications/{notificationId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.userId;
    }
    
    // AI insights are private to the user
    match /aiInsights/{insightId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.userId;
    }
  }
}
`;

// Cloud Functions Triggers
const cloudFunctionsTriggers = [
  // User creation trigger
  {
    name: "onUserCreate",
    trigger: "auth.user().onCreate",
    description: "Initialize user document when account is created"
  },
  
  // Health data analysis trigger
  {
    name: "onHealthDataWrite",
    trigger: "firestore.document('healthData/{documentId}').onWrite",
    description: "Analyze health data and generate AI insights"
  },
  
  // Challenge progress update trigger
  {
    name: "onChallengeParticipantUpdate",
    trigger: "firestore.document('challenges/{challengeId}/participants/{userId}').onUpdate",
    description: "Update challenge leaderboards and check completion"
  },
  
  // Achievement unlock trigger
  {
    name: "onAchievementUnlock",
    trigger: "firestore.document('users/{userId}/achievements/{achievementId}').onCreate",
    description: "Send notification when user unlocks achievement"
  },
  
  // Community post trigger
  {
    name: "onPostCreate",
    trigger: "firestore.document('posts/{postId}').onCreate",
    description: "Notify community members of new posts"
  },
  
  // Daily health summary trigger
  {
    name: "dailyHealthSummary",
    trigger: "pubsub.schedule('0 6 * * *')",
    description: "Generate daily health summaries for all users"
  }
];

export {
  firestoreIndexes,
  firestoreRules,
  cloudFunctionsTriggers
};