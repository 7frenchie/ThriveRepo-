  email: "user@example.com",
  name: "John Doe",
  avatar: "https://example.com/avatar.jpg", // optional
  createdAt: "2024-01-15T10:30:00Z",
  updatedAt: "2024-01-15T10:30:00Z",
  preferences: {
    theme: "system", // 'light' | 'dark' | 'system'
    notifications: {
      push: true,
      email: false,
      challenges: true,
      social: true
    },
    privacy: {
      profile: "public", // 'public' | 'friends' | 'private'
      healthData: "private",
      achievements: "public"
    },
    units: {
      distance: "km", // 'km' | 'miles'
      weight: "kg", // 'kg' | 'lbs'
      temperature: "celsius" // 'celsius' | 'fahrenheit'
    }
  },
  subscription: {
    tier: "free", // 'free' | 'premium'
    expiresAt: null, // timestamp for premium users
    features: ["basic_tracking", "community_access"]
  },
  stats: {
    totalPoints: 0,
    currentStreak: 0,
    longestStreak: 0,
    challengesCompleted: 0,
    communitiesJoined: 0
  }
};

